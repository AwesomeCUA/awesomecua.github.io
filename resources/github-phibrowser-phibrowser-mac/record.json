/LICENSE"},{"method":"license_header","retrieved_at":"2026-10-18T15:44:45Z","role":"primary","sha256":"7c1eb6bf2936ea78c389fd1fa17e116364853a1577df105bc4db6fd929b849c3","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/phibrowser/phibrowser-mac/HEAD/LICENSE"}],"id":"github:phibrowser/phibrowser-mac","identifiers":{},"kind":"infrastructure","last_verified_at":"2026-10-18T15:44:36Z","licenses":{"code":{"basis":"repository LICENSE header","declared":"Apache-2.0","retrieved_at":"2026-10-18T15:44:45Z","url":"https://raw.githubusercontent.com/phibrowser/phibrowser-mac/HEAD/LICENSE"},"data":null,"document":null,"weights":null},"links":[{"rel":"primary","url":"https://github.com/phibrowser/phibrowser-mac"}],"name":"Phi Browser","notes":"This is the open macOS client (Swift, AppKit and SwiftUI). Building it requires the prebuilt Phi Framework, the publisher's own Chromium build, whose source is unpublished; the built-in assistant's models, prompts and pipelines run server-side, outside this repository, and a self-built copy has no Phi Cloud access. Sources/ChromiumBridge/AgentCDP/AgentCDPListener.swift owns a Unix-domain socket through which agent tools reach the browser's DevTools endpoint after per-agent user consent. tools/phi-browser-skill (SKILL.md, scripts/lib/cdp.mjs) is an Agent Skill that drives agent Spaces: hidden windows on a chosen profile that the user can watch, take over and hand back, or off-screen shadow windows. Privacy and local-model statements are publisher claims.","published_at":null,"relations":[],"review_status":"curated","scope":"core","summary":"Native macOS client of a Chromium browser whose agent Spaces let the built-in assistant or external agents drive windows over a consent-gated DevTools Protocol socket while the user watches and can take control.","topics":["web-navigation","human-in-the-loop","safety-security"],"updated_at":null,"url":"https://github.com/phibrowser/phibrowser-mac"}

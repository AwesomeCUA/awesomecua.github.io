ead16b6c4cb","supports":["summary","environments","notes"],"url":"https://raw.githubusercontent.com/Saidgurbuz/screenparse/b294659b87fb75f3fd4964310fd2039d385749b3/webshot/src/webshot/worker.py"},{"method":"editorial_primary_review","retrieved_at":"2026-10-18T15:41:51Z","role":"primary","sha256":"bbe1e8d6480be763a960acf26233371436a8c7d56fa1e9453941ddc8e7397125","supports":["summary","notes"],"url":"https://raw.githubusercontent.com/Saidgurbuz/screenparse/b294659b87fb75f3fd4964310fd2039d385749b3/webshot/src/webshot/vlm_refine.py"},{"method":"editorial_primary_review","retrieved_at":"2026-10-18T15:41:51Z","role":"primary","sha256":"46668f27c02bfb2e72e5e46d367da7edae0a92bc96e6d11eb3ac3e162d03ae6f","supports":["summary","notes"],"url":"https://raw.githubusercontent.com/Saidgurbuz/screenparse/b294659b87fb75f3fd4964310fd2039d385749b3/webshot/src/webshot/cli.py"},{"method":"editorial_primary_review","retrieved_at":"2026-10-18T15:41:51Z","role":"primary","sha256":"3926f452b0ab3d851f4bfb51dd19a9cb9f69a27884af627955a8bf6ebf44ae08","supports":["topics","notes"],"url":"https://raw.githubusercontent.com/Saidgurbuz/screenparse/b294659b87fb75f3fd4964310fd2039d385749b3/webshot/src/evaluation/cli.py"},{"method":"license_header","retrieved_at":"2026-10-18T15:42:37Z","role":"primary","sha256":"218ebc9b68eff8966a9254026d63d88c67c8e8aa3127de3dda7a66cae7d666a1","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/Saidgurbuz/screenparse/HEAD/LICENSE"}],"id":"github:saidgurbuz/screenparse","identifiers":{},"kind":"framework","last_verified_at":"2026-10-18T15:41:48Z","licenses":{"code":{"basis":"repository LICENSE header; not a weights/data license","declared":"MIT","retrieved_at":"2026-10-18T15:42:37Z","url":"https://raw.githubusercontent.com/Saidgurbuz/screenparse/HEAD/LICENSE"},"data":null,"document":null,"weights":null},"links":[{"rel":"primary","url":"https://github.com/Saidgurbuz/screenparse"}],"name":"ScreenParse Webshot toolkit","notes":"The README calls this the official code release for the ICML 2026 paper and links the ScreenParse dataset and the ScreenVLM and ScreenParser checkpoints on Hugging Face; none of them is stored in this repository, and the only training script, scripts/train.py, trains Ultralytics YOLO detectors. At commit b294659b, webshot/src/webshot/worker.py drives Chromium through Playwright, dismisses cookie banners and overlays, and records each visible DOM element's tag, role, attributes, text, bounding rectangle and parent and child indices with a screenshot; vlm_refine.py and vlm_quality_score.py relabel elements and score annotation quality with Qwen3-VL-8B-Instruct by default through vLLM. The evaluation CLI runs YOLO, RT-DETR, OmniParser weights, Qwen3-VL, InternVL3, Gemini, PaddleOCR-VL and ScreenVLM on YOLO-format, GroundCUA or ScreenSpot data and reports PageIoU, label PageIoU, mAP, recall and NED. The Webshot README's 771K-screenshot and 21M-element figures describe the dataset and were not checked here. MIT covers this code only; dataset and checkpoint terms are declared on their own Hub pages.","published_at":null,"relations":[{"evidence_url":"https://raw.githubusercontent.com/Saidgurbuz/screenparse/b294659b87fb75f3fd4964310fd2039d385749b3/README.md","target_id":"arxiv:2602.14276","type":"documented_by"}],"review_status":"curated","scope":"core","summary":"Official ScreenParse code: the Webshot toolkit that renders websites with Playwright, records visible DOM elements as boxed, nested annotations, relabels them with Qwen3-VL, exports YOLO data and evaluates parsers.","topics":["screen-understanding","data-generation","evaluation"],"updated_at":null,"url":"https://github.com/Saidgurbuz/screenparse"}

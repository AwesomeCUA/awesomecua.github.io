ba84736/src/lib/ai-login/types.ts"},{"method":"license_header","retrieved_at":"2026-10-18T12:26:44Z","role":"primary","sha256":"c268300fd627deb702f7647767590e36184083a5e23e40cb76ecbe07fbfe5132","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/RichardHruby/login-machine/HEAD/LICENSE"}],"id":"github:richardhruby/login-machine","identifiers":{},"kind":"agent","last_verified_at":"2026-10-18T12:26:18Z","licenses":{"code":{"basis":"repository LICENSE header","declared":"MIT","retrieved_at":"2026-10-18T12:26:44Z","url":"https://raw.githubusercontent.com/RichardHruby/login-machine/HEAD/LICENSE"},"data":null,"document":null,"weights":null},"links":[{"rel":"primary","url":"https://github.com/RichardHruby/login-machine"}],"name":"Login Machine","notes":"Built by @RichardHruby and @jesse-olympus at Anon as a Next.js app. Each step sends a JPEG screenshot and form-relevant HTML (walking into shadow roots) to claude-sonnet-4-5-20250929, which returns one of six typed screen states (credential_login_form, choice_screen, magic_login_link, loading_screen, blocked_screen, logged_in_screen) with Playwright locators; locators unresolved in the live DOM are fed back for up to three analysis attempts. Browsers are Browserbase sessions reached over CDP, so Anthropic and Browserbase keys are required. The user supplies credentials, choices and magic links through the chat UI, and Playwright types or clicks them. package.json is a private app (login-machine 0.1.0); a hosted demo is linked from the README.","published_at":null,"relations":[{"evidence_url":"https://raw.githubusercontent.com/RichardHruby/login-machine/e1da92965029ce23bfc372f4483ed7c55ba84736/src/lib/ai-login/browser.ts","target_id":"url:978d1dcd70fde8661b9e","type":"uses"}],"review_status":"curated","scope":"core","summary":"Browser agent loop for website logins: Claude classifies each login screen from a screenshot and stripped HTML and returns DOM-checked Playwright locators; user-entered credentials never reach the model.","topics":["web-navigation","human-in-the-loop","safety-security"],"updated_at":null,"url":"https://github.com/RichardHruby/login-machine"}

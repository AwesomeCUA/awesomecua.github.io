ved_at":"2026-10-18T11:55:36Z","role":"primary","sha256":"7a27d023f3576d7c12cdbe428f920469539fde6419cfcbe52a0cb1e9ba8e89a7","supports":["aliases"],"url":"https://api.github.com/repos/HKUDS/OpenPhone"},{"method":"github_repository_identity","retrieved_at":"2026-10-18T11:55:37Z","role":"primary","sha256":"7a27d023f3576d7c12cdbe428f920469539fde6419cfcbe52a0cb1e9ba8e89a7","supports":["aliases"],"url":"https://api.github.com/repos/HKUDS/PhoneCLI"}],"id":"github:hkuds/phonecli","identifiers":{},"kind":"framework","last_verified_at":"2026-10-18T11:56:14Z","licenses":{"code":{"basis":"repository LICENSE header; not a weights/data license","declared":"MIT","retrieved_at":"2026-10-18T11:56:35Z","url":"https://raw.githubusercontent.com/HKUDS/PhoneCLI/HEAD/LICENSE"},"data":null,"document":null,"weights":null},"links":[{"rel":"primary","url":"https://github.com/HKUDS/PhoneCLI"}],"name":"PhoneCLI","notes":"Formerly published as HKUDS/OpenPhone; that address now resolves to this repository. phonecli/ is the iOS harness (WebDriverAgent) with prebuilt app maps, and phonecli_android/ runs the AndroidLab suite with compiled maps and a pure-VLM baseline. The repository also holds OpenPhone-3B training and synthetic-data pipelines and vLLM serving scripts; the weights and dataset are separate Hugging Face releases outside this repository record. Its evaluation replaces AndroidLab's rule-based checks with an LLM judge. The LICENSE names AndroidLab's author as a copyright holder.","published_at":null,"relations":[{"evidence_url":"https://raw.githubusercontent.com/HKUDS/PhoneCLI/HEAD/README.md","target_id":"arxiv:2609.35671","type":"documented_by"},{"evidence_url":"https://raw.githubusercontent.com/HKUDS/PhoneCLI/HEAD/README.md","target_id":"arxiv:2510.22009","type":"documented_by"}],"review_status":"curated","scope":"core","summary":"Mobile-agent harness that crawls an app into a YAML map of screens, replays compiled navigation commands through WebDriverAgent on iOS or ADB on Android, and
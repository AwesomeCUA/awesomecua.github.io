7361b80074e376de55115338401f46ef5f99f008d2f93d1127cce7ab799c7a","supports":["summary","notes"],"url":"https://raw.githubusercontent.com/alexvilelabah/bah-browser/6441bdce349ab31041c79f5b9002d82e0fa9f4bc/src/main/main.ts"},{"method":"editorial_primary_review","retrieved_at":"2026-10-18T15:46:12Z","role":"primary","sha256":"40a1c1e0a2996effbe5ab31283e34886b02125428d23bfb5d69aaa14e0dd17f7","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/alexvilelabah/bah-browser/6441bdce349ab31041c79f5b9002d82e0fa9f4bc/LICENSE"},{"method":"license_header","retrieved_at":"2026-10-18T15:46:47Z","role":"primary","sha256":"40a1c1e0a2996effbe5ab31283e34886b02125428d23bfb5d69aaa14e0dd17f7","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/alexvilelabah/bah-browser/HEAD/LICENSE"}],"id":"github:alexvilelabah/bah-browser","identifiers":{},"kind":"agent","last_verified_at":"2026-10-18T15:46:09Z","licenses":{"code":{"basis":"repository LICENSE header; not a weights/data license","declared":"MIT","retrieved_at":"2026-10-18T15:46:47Z","url":"https://raw.githubusercontent.com/alexvilelabah/bah-browser/HEAD/LICENSE"},"data":null,"document":null,"weights":null},"links":[{"rel":"primary","url":"https://github.com/alexvilelabah/bah-browser"}],"name":"Bah","notes":"Browser application by VilelaLab with Windows and macOS builds (release v1.9.2). The agent loop observes each page through an injected script or the CDP accessibility tree (src/renderer/page-executor.ts), adds tesseract.js OCR text, and attaches a page screenshot only when the configured model accepts images (src/main/ai-engine.ts); clicks and keys go through Electron sendInputEvent on the page (src/main/main.ts). Tools include element-reference clicks and fills, coordinate clicks, tabs and navigation, plus non-interface skills such as image generation, video and price lookups. The README states a 25-step cap, confirmation before paying, buying, deleting or entering card data, and a hand-off on CAPTCHAs and login walls. It runs in the user's persistent logged-in session, presents a Chrome user agent and masks navigator.webdriver, and the app also bundles an ad blocker, password manager, media downloader and torrent client. Supported providers are DeepSeek, Mistral, NVIDIA NIM and Ollama.","published_at":null,"relations":[],"review_status":"curated","scope":"core","summary":"Electron AI browser whose side-panel agent reads numbered page elements from the DOM or accessibility tree, page text and OCR, then clicks and types through Chromium input events, using cloud or local Ollama models.","topics":["web-navigation","human-in-the-loop","automation"],"updated_at":null,"url":"https://github.com/alexvilelabah/bah-browser"}

url":"https://raw.githubusercontent.com/vectora-foundry/native-devtools-mcp/cf346e05df02eaf9cd1d2228233fe52b4cfa9213/src/macos/ax.rs"},{"method":"editorial_primary_review","retrieved_at":"2026-10-20T08:00:00Z","role":"primary","sha256":"ca0ec9d8b32336cca7ed726a883e70bbbca368ce2547efce247af2e2c5a9c998","supports":["summary","notes"],"url":"https://raw.githubusercontent.com/vectora-foundry/native-devtools-mcp/cf346e05df02eaf9cd1d2228233fe52b4cfa9213/src/cdp/mod.rs"},{"method":"editorial_primary_review","retrieved_at":"2026-10-20T07:59:59Z","role":"primary","sha256":"1e0814adeb0adeb45e76d0d6c613b04e63dc3e4a186b0fd4ff0e76996b1ced36","supports":["summary","notes"],"url":"https://raw.githubusercontent.com/vectora-foundry/native-devtools-mcp/cf346e05df02eaf9cd1d2228233fe52b4cfa9213/src/android/input.rs"},{"method":"editorial_primary_review","retrieved_at":"2026-10-20T08:00:00Z","role":"primary","sha256":"2c1ab7c72d82a40829aa07870d446175fd52eebb0f95376cc3c50ebbc9bfe33e","supports":["topics","notes"],"url":"https://raw.githubusercontent.com/vectora-foundry/native-devtools-mcp/cf346e05df02eaf9cd1d2228233fe52b4cfa9213/src/tools/hover_tracker.rs"},{"method":"editorial_primary_review","retrieved_at":"2026-10-20T08:00:00Z","role":"primary","sha256":"1813232deb7c18ae02acefcfa7bf01d4753798c2707d61a35ba954ee471e2513","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/vectora-foundry/native-devtools-mcp/cf346e05df02eaf9cd1d2228233fe52b4cfa9213/LICENSE"},{"method":"license_header","retrieved_at":"2026-10-20T08:00:30Z","role":"primary","sha256":"1813232deb7c18ae02acefcfa7bf01d4753798c2707d61a35ba954ee471e2513","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/vectora-foundry/native-devtools-mcp/HEAD/LICENSE"}],"id":"github:vectora-foundry/native-devtools-mcp","identifiers":{},"kind":"tool","last_verified_at":"2026-10-20T08:00:27Z","licenses":{"code":{"basis":"repository LICENSE header","declared":"MIT","retrieved_at":"2026-10-20T08:00:30Z","url":"https://raw.githubusercontent.com/vectora-foundry/native-devtools-mcp/HEAD/LICENSE"},"data":null,"document":null,"weights":null},"links":[{"rel":"primary","url":"https://github.com/vectora-foundry/native-devtools-mcp"}],"name":"native-devtools-mcp","notes":"Distributed through npm (npx native-devtools-mcp; version 0.10.1 in npm/package.json and Cargo.toml at the inspected commit) and as a signed macOS app for Claude Desktop. On macOS it can walk the Accessibility tree and dispatch AXPress, value and selection changes without moving the cursor (src/macos/ax.rs), besides CGEvent input and Vision OCR; Windows uses SendInput, UI Automation and Windows Media OCR. Chrome and Electron pages are driven through the Chrome DevTools Protocol with chromiumoxide (src/cdp/mod.rs), and Android through adb shell input and uiautomator (src/android/input.rs). Optional start_recording captures window frames and hover tracking reports dwell-filtered pointer positions with the element under them (src/tools/hover_tracker.rs). The README limits support to platforms other than Linux and iOS. The server contains no model or agent loop; an MCP client supplies the agent.","published_at":null,"relations":[],"review_status":"curated","scope":"core","summary":"Local Rust MCP server for operating macOS and Windows apps, Chrome or Electron pages over CDP, and Android devices over ADB, with screenshots, OCR, accessibility lookup, input and template matching.","topics":["tool-integration","automation","screen-understanding","recording"],"updated_at":null,"url":"https://github.com/vectora-foundry/native-devtools-mcp"}

d":"url:93278fa5b9e6bd0cbcef","identifiers":{},"kind":"dataset","last_verified_at":"2026-10-18T12:32:23Z","licenses":{"code":null,"data":{"basis":"publisher model/dataset card metadata","declared":"apache-2.0","retrieved_at":"2026-10-18T12:32:23Z","url":"https://huggingface.co/datasets/UI-MOPD/Uni-GUI-Mobile/raw/45244387a3c284810894bc2be974b28014dcf838/README.md"},"document":null,"weights":null},"links":[{"rel":"primary","url":"https://huggingface.co/datasets/UI-MOPD/Uni-GUI-Mobile"}],"name":"Uni-GUI-Mobile","notes":"The UI-MOPD paper builds Uni-GUI from self-collected desktop and mobile trajectories plus cleaned OpenCUA and OpenMobile trajectories; this repository is the self-collected mobile part (the paper's composition table rounds it to about 1K trajectories and 17K steps, the card reports about 14K steps). Per the paper, teacher models produced the rollouts, an automatic judge kept only successful ones, and reasoning traces were rewritten into one format. The card says only 'mobile'; Android is inferred from the adb commands in its step records and the paper's use of AndroidWorld and MobileWorld environments for mobile queries. Apache-2.0 is the card's declaration for the data.","published_at":null,"relations":[{"evidence_url":"https://huggingface.co/datasets/UI-MOPD/Uni-GUI-Mobile/raw/45244387a3c284810894bc2be974b28014dcf838/README.md","target_id":"arxiv:2607.04425","type":"documented_by"}],"review_status":"curated","scope":"core","summary":"Self-collected phone trajectories from the UI-MOPD training data: 871 tasks across 10 app categories, each with step screenshots, reasoning traces, normalized tap, swipe and type actions, and adb commands.","task_classes":["R01.11.01.01"],"topics":["data-generation","mobile-navigation","imitation-learning"],"updated_at":null,"url":"https://huggingface.co/datasets/UI-MOPD/Uni-GUI-Mobile"}

      ],
      "focus": [
        "Browser-representation token use",
        "Factual READ accuracy",
        "ACT target-element selection"
      ],
      "notes": "Fixed local-page observations; the reported run uses claude-sonnet-5 and a shared prompt, without scrolling or an agent loop. Browser Use disables its viewport cutoff and sends untruncated text; Stagehand uses a separate matched browser load. Short-string representability labels are approximate. Offline does not mean API-free. Third-party snapshot redistribution remains unresolved; results were not reproduced.",
      "observations": [
        "Top-document HTML",
        "Markdown converted from HTML",
        "Playwright accessibility snapshot",
        "Browser Use indexed DOM",
        "Stagehand hybrid snapshot",
        "Viewport screenshot"
      ],

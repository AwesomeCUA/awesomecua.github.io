t":"2026-10-18T16:15:27Z","role":"primary","sha256":"09ea4c8909e48f4ccaad85df33c0e79b6ad27704422aee0c41efbb510f682b97","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/rkvalandas/browser_agent/2070c4eec9bbb0f55d63b4ac3728fd881c0de734/LICENSE"},{"method":"license_header","retrieved_at":"2026-10-18T16:15:52Z","role":"primary","sha256":"09ea4c8909e48f4ccaad85df33c0e79b6ad27704422aee0c41efbb510f682b97","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/rkvalandas/browser_agent/HEAD/LICENSE"}],"id":"github:rkvalandas/browser_agent","identifiers":{},"kind":"agent","last_verified_at":"2026-10-18T16:15:38Z","licenses":{"code":{"basis":"repository LICENSE header","declared":"MIT","retrieved_at":"2026-10-18T16:15:52Z","url":"https://raw.githubusercontent.com/rkvalandas/browser_agent/HEAD/LICENSE"},"data":null,"document":null,"weights":null},"links":[{"rel":"primary","url":"https://github.com/rkvalandas/browser_agent"}],"name":"Browser Agent","notes":"Single-author personal project. browser/browser_setup.py connects to Chrome on localhost:9222 through connect_over_cdp and launches Chrome with remote debugging when none is running. browser/analyzers/page_analyzer.py runs a DOM script that classifies elements by tag and ARIA role, builds unique selectors and detects modal overlays; no screenshots are taken. docs/BROWSER_TOOLS.md documents the tool set (analyze_page, navigate, go_back, scroll, click, type, select_option, keyboard_action, ask_user). LLM backends are OpenAI, Azure OpenAI, Groq or Anthropic (agent/llm_providers.py). No evaluation results are published.","published_at":null,"relations":[],"review_status":"curated","scope":"core","summary":"Python agent that attaches Playwright to a local Chrome over CDP, maps visible interactive elements from the DOM into numbered IDs, and lets an LLM navigate, click, type, select and ask the user for missing input.","topics":["web-navigation","automation","human-in-the-loop"],"updated_at":null,"url":"https://github.com/rkvalandas/browser_agent"}

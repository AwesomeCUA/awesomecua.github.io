  "details": {
    "benchmark_protocol": {
      "actions": [
        "pixel (x,y) cursor coordinate"
      ],
      "counts": [],
      "evaluation": "The inspected evaluator scales target boxes from a 1000×1000 reference grid into image pixels and tests pixel predictions, allowing ±10 pixels around the center along any target dimension narrower than 1 pixel after scaling. It reports cumulative hit accuracy by turn (earlier hits remain correct), miss distances, any-turn hit rate, and a correction rate whose denominator is all successfully processed samples. The default budget is five turns; retain prompt/feedback variant, turn budget, and processed/skipped coverage.",
      "evidence_urls": [
        "https://raw.githubusercontent.com/microsoft/precision-cua-bench/HEAD/README.md",
        "https://raw.githubusercontent.com/microsoft/precision-cua-bench/HEAD/eval/test_allturns_api.py",
        "https://api.github.com/repos/microsoft/precision-cua-bench/git/trees/main?recursive=1"
      ],
      "focus": [
        "pixel-precise editor cursor placement",
        "multi-turn visual self-correction"
      ],
      "notes": "The release has four editor/theme JSONL partitions (Cursor/VS Code × dark/light) and screenshot files. Partitions are not train/test splits or independent task totals. README’s initial field table calls bbox pixel coordinates, but the evaluation-format section and actual ratio_h/ratio_w=dimension/1000 code use normalized target boxes; profile follows the inspected evaluator and retains the inconsistency. Source/images were not executed or downloaded as a dataset. MIT is recorded for repository code only.",
      "observations": [
        "code-editor screenshot",
        "cursor-location instruction",
        "red-cross feedback marking previous incorrect prediction"
      ],
      "setting": "offline"
    }
  },
  "environments": [
    "cross-platform"
  ],

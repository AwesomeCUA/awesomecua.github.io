ShiinaHiiragi/kalgebra/e3f962b95447d3b76244edbc2048a8c98e2022b7/src/main.cpp"},{"method":"license_header","retrieved_at":"2026-10-18T12:15:13Z","role":"primary","sha256":"8177f97513213526df2cf6184d8ff986c675afb514d4e68a404010521b880643","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/ShiinaHiiragi/kalgebra/HEAD/COPYING"}],"id":"github:shiinahiiragi/kalgebra","identifiers":{},"kind":"infrastructure","last_verified_at":"2026-10-18T12:15:00Z","licenses":{"code":{"basis":"repository LICENSE header; GNU text names no -only or -or-later variant","declared":"GPL-2.0","retrieved_at":"2026-10-18T12:15:13Z","url":"https://raw.githubusercontent.com/ShiinaHiiragi/kalgebra/HEAD/COPYING"},"data":null,"document":null,"weights":null},"links":[{"rel":"primary","url":"https://github.com/ShiinaHiiragi/kalgebra"}],"name":"kalgebra-kai","notes":"GitHub reports this repository as a fork of KDE/kalgebra. The ScienceBoard README lists it among its modified applications as \"a recompilation copy of KAlgebra\". The Debian control file at commit e3f962b names the package kalgebra-kai (version 1.1) and describes it as a modified KAlgebra that supports a local server. main.cpp starts that server on the port given as the first argument (default 8000) with /version, /vars, /func/2d and /func/3d status routes and /tab, /add/calc, /add/2d and /add/3d operation routes. manual.md holds the maintainer's Qt 6.5 build and .deb packaging steps. Everything except the server additions is upstream KAlgebra code.","published_at":null,"relations":[{"evidence_url":"https://raw.githubusercontent.com/OS-Copilot/ScienceBoard/21b5eb0f1d00898f7de9e84c3d33a87c2f2b3c3e/README.md","target_id":"github:os-copilot/scienceboard","type":"component_of"}],"review_status":"curated","scope":"adjacent","summary":"Modified KAlgebra build from ScienceBoard with a local HTTP server that reports variables and plotted 2D and 3D functions and can switch tabs or add calculations and plots, so the benchmark can check math tasks.","topics":["science","evaluation","state-tracking"],"updated_at":null,"url":"https://github.com/ShiinaHiiragi/kalgebra"}

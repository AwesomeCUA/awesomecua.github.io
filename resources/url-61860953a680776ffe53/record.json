{"aliases":[],"authors":[],"details":{"benchmark_protocol":{"actions":["recorded Android atomic actions","recorded PC pyautogui actions","click coordinates for grounding"],"counts":[{"basis":"reported","evidence_url":"https://huggingface.co/datasets/ShaofantuoshuzhengzhiSha/GUIGuard-Bench/raw/c2b5ca415cd854452585260b9eaa74699042d920/README.md","population":"public-ladder evaluation set (68 Android + 53 PC)","qualifier":"exact","unit":"evaluation trajectories","value":121},{"basis":"reported","evidence_url":"https://huggingface.co/datasets/ShaofantuoshuzhengzhiSha/GUIGuard-Bench/raw/c2b5ca415cd854452585260b9eaa74699042d920/README.md","population":"public-ladder evaluation set, data/eval.jsonl","qualifier":"exact","unit":"screenshots (evaluation samples)","value":2002},{"basis":"reported","evidence_url":"https://huggingface.co/datasets/ShaofantuoshuzhengzhiSha/GUIGuard-Bench/raw/c2b5ca415cd854452585260b9eaa74699042d920/README.md","population":"public-ladder evaluation set","qualifier":"exact","unit":"region-level privacy annotations","value":26407},{"basis":"computed","evidence_url":"https://huggingface.co/api/datasets/ShaofantuoshuzhengzhiSha/GUIGuard-Bench/revision/c2b5ca415cd854452585260b9eaa74699042d920","population":"Android/ at revision c2b5ca41","qualifier":"exact","unit":"Android task directories","value":68},{"basis":"computed","evidence_url":"https://huggingface.co/api/datasets/ShaofantuoshuzhengzhiSha/GUIGuard-Bench/revision/c2b5ca415cd854452585260b9eaa74699042d920","population":"PC/ at revision c2b5ca41","qualifier":"exact","unit":"PC task directories","value":53}],"evaluation":"Region-level privacy labels (risk level, category, task essentiality, boxes) support recognition scoring; planning is compared before and after protection methods (black mask, mosaic, random blocks, LLM text replacement); grounding follows a ScreenSpot-style click check. The card does not ship a scorer; it points to an anonymized toolkit.","evidence_urls":["https://huggingface.co/datasets/ShaofantuoshuzhengzhiSha/GUIGuard-Bench/raw/c2b5ca415cd854452585260b9eaa74699042d920/README.md","https://huggingface.co/api/datasets/ShaofantuoshuzhengzhiSha/GUIGuard-Bench/revision/c2b5ca415cd854452585260b9eaa74699042d920","https://raw.githubusercontent.com/Futuresis/GUIGuard-page/df9c709058d7e39d1f9286edd33c9f645aa60b55/index.html"],"focus":["privacy-risk recognition in GUI agent screenshots","agent planning fidelity on privacy-protected screenshots","click grounding under visual privacy protection"],"notes":"Trajectories, screenshots and annotations are different units and are counted separately. The manifest also lists 1,239 Android and 763 PC images, which together match the 2,002 samples. A script over data/eval.jsonl at this revision (11 MB, read once) found 2,002 rows from 121 task folders, 26,407 privacy labels and 1,949 labelled rows, matching the card. Reference-only folders hold 238 and 150 top-level directories; they are excluded from these counts.","observations":["recorded trajectory screenshots","task goals","plan and progress text"],"setting":"offline"},"disabled":false,"download_url":"https://huggingface.co/datasets/ShaofantuoshuzhengzhiSha/GUIGuard-Bench/tree/c2b5ca415cd854452585260b9eaa74699042d920","gated":false,"hub_id":"ShaofantuoshuzhengzhiSha/GUIGuard-Bench","hub_revision":"c2b5ca415cd854452585260b9eaa74699042d920","license_review":{"data":{"evidence_urls":["https://huggingface.co/datasets/ShaofantuoshuzhengzhiSha/GUIGuard-Bench/raw/c2b5ca415cd854452585260b9eaa74699042d920/README.md"],"reason":"Publisher dataset-card declaration for this release."}}},"environments":["android","desktop","linux"],"evidence":[{"method":"editorial_primary_review","retrieved_at":"2026-10-18T15:37:19Z","role":"primary","sha256":"81a85cdefb48b37f9869eaa61832d9d97f288cbd443be74e07d779f7948ae229","supports":["name","kind","summary","environments","topics","scope","notes","licenses.data","details.benchmark_protocol"],"url":"https://huggingface.co/datasets/Shao
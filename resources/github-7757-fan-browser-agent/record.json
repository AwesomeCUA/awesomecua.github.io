e8cf4d58b85fce6a636d6b6dac7/LICENSE"},{"method":"license_header","retrieved_at":"2026-10-18T16:08:09Z","role":"primary","sha256":"8a4885604d276a67e12363f648ac06e27b55d53cea9742a67aac7ecaed0ff655","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/7757/Fan-Browser-Agent/HEAD/LICENSE"}],"id":"github:7757/fan-browser-agent","identifiers":{},"kind":"agent","last_verified_at":"2026-10-18T16:07:48Z","licenses":{"code":{"basis":"repository LICENSE header","declared":"MIT","retrieved_at":"2026-10-18T16:08:09Z","url":"https://raw.githubusercontent.com/7757/Fan-Browser-Agent/HEAD/LICENSE"},"data":null,"document":null,"weights":null},"links":[{"rel":"primary","url":"https://github.com/7757/Fan-Browser-Agent"}],"name":"Fan","notes":"Early-preview desktop app (v0.4.3 unsigned builds for macOS, Windows and Linux were the latest GitHub release at review). The README states that its Python agent runtime is adapted from Nous Research's Hermes Agent under MIT, and the root LICENSE keeps both copyright notices. Observation (apps/desktop/electron/browser-runtime/observation/operations.cjs) combines CDP DOMSnapshot.captureSnapshot with Accessibility.getFullAXTree into a numbered snapshot; browser_snapshot can attach a plain screenshot or one with numbered element boxes. browser_run executes model-written JavaScript against a sandboxed fan.* API, clicks go through Input.dispatchMouseEvent, and browser_handoff returns control to the user. The runtime also has terminal, file, memory, MCP and scheduled-task tools. Models come from user-configured providers.","published_at":null,"relations":[],"review_status":"curated","scope":"core","summary":"Electron desktop agent that operates an embedded, visible Chromium browser from numbered DOM and accessibility snapshots, runs bounded JavaScript browser transactions, and hands control back for logins and risky steps.","topics":["web-navigation","human-in-the-loop","automation"],"updated_at":null,"url":"https://github.com/7757/Fan-Browser-Agent"}

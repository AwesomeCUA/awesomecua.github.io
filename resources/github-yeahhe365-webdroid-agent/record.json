ontextBuilder.ts"},{"method":"editorial_primary_review","retrieved_at":"2026-10-18T15:43:26Z","role":"primary","sha256":"d230898643e76658658013ed915124d85a7b16167901885b271d5f2dd42e7110","supports":["summary","notes"],"url":"https://raw.githubusercontent.com/yeahhe365/WebDroid-Agent/6ef50805d0f4509d7222dd269d8e329ab95ec902/src/adapters/inputCommands.ts"},{"method":"editorial_primary_review","retrieved_at":"2026-10-18T15:43:28Z","role":"primary","sha256":"e8f924156a6cc9479b17cb02a420d180f58d1532d170c30fc120c197dfcf06b6","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/yeahhe365/WebDroid-Agent/6ef50805d0f4509d7222dd269d8e329ab95ec902/LICENSE"},{"method":"license_header","retrieved_at":"2026-10-18T15:44:10Z","role":"primary","sha256":"e8f924156a6cc9479b17cb02a420d180f58d1532d170c30fc120c197dfcf06b6","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/yeahhe365/WebDroid-Agent/HEAD/LICENSE"},{"method":"github_repository_identity","retrieved_at":"2026-10-18T15:43:24Z","role":"primary","sha256":"9fd700009d98c4d7e5713d6a37f0b52bc2cd0b6edf3373c49f3578e30027c1dd","supports":["aliases"],"url":"https://api.github.com/repos/yeahhe365/webadb-autoglm"},{"method":"github_repository_identity","retrieved_at":"2026-10-18T15:43:23Z","role":"primary","sha256":"9fd700009d98c4d7e5713d6a37f0b52bc2cd0b6edf3373c49f3578e30027c1dd","supports":["aliases"],"url":"https://api.github.com/repos/yeahhe365/WebDroid-Agent"}],"id":"github:yeahhe365/webdroid-agent","identifiers":{},"kind":"agent","last_verified_at":"2026-10-18T15:43:22Z","licenses":{"code":{"basis":"repository LICENSE header","declared":"MIT","retrieved_at":"2026-10-18T15:44:10Z","url":"https://raw.githubusercontent.com/yeahhe365/WebDroid-Agent/HEAD/LICENSE"},"data":null,"document":null,"weights":null},"links":[{"rel":"primary","url":"https://github.com/yeahhe365/WebDroid-Agent"}],"name":"WebDroid Agent","notes":"A React app that runs entirely in a Chromium browser (WebUSB through Tango/WebADB), or in Docker with a local proxy for model requests; the browser is the controller and the operated surface is a USB-connected Android device. Each step captures screencap output and, best effort, a compressed uiautomator dump of visible text, IDs, clickable state and bounds (src/lib/contextBuilder.ts); actions use pixel or 0-1000 normalized coordinates and become adb input, am start and keyboard-broadcast commands (src/adapters/inputCommands.ts). Sensitive taps can require confirmation, take_over hands control back to the user and type_secret sends the model only a secret ID; an unrestricted mode skips these checks. README.md is in Chinese and README.en-US.md is the English version. The repository was renamed from yeahhe365/webadb-autoglm (same repository ID 1244747615).","published_at":null,"relations":[],"review_status":"curated","scope":"core","summary":"Browser-hosted Android phone agent that connects over WebUSB/WebADB, sends screenshots plus a uiautomator text tree to an OpenAI-compatible or Gemini vision model, and runs its JSON actions through ADB.","topics":["mobile-navigation","human-in-the-loop","automation"],"updated_at":null,"url":"https://github.com/yeahhe365/WebDroid-Agent"}

35b021b73020825da054b5c92cc1288/docs/windows.md"},{"method":"editorial_primary_review","retrieved_at":"2026-10-18T11:52:41Z","role":"primary","sha256":"b27b4c4315c441dd59e1c8538ae7cf78d807f0f3335255542ba7fddb7ab038b3","supports":["environments","notes"],"url":"https://raw.githubusercontent.com/awlevin/typesafe-computer-use/44ca11f0935b021b73020825da054b5c92cc1288/docs/browser-backend.md"},{"method":"editorial_primary_review","retrieved_at":"2026-10-18T11:52:41Z","role":"primary","sha256":"cd0bb7adb46f77e0889b166e7ecc2490e5cf200396a7b7b446a446b14745b920","supports":["identity","details.package_version","details.repository_revision"],"url":"https://raw.githubusercontent.com/awlevin/typesafe-computer-use/44ca11f0935b021b73020825da054b5c92cc1288/pyproject.toml"},{"method":"editorial_primary_review","retrieved_at":"2026-10-18T11:52:41Z","role":"primary","sha256":"fb99135e22841bb564b275b5c0755ce1e5418faff2c806f25d4a11696214c87c","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/awlevin/typesafe-computer-use/44ca11f0935b021b73020825da054b5c92cc1288/LICENSE"},{"method":"license_header","retrieved_at":"2026-10-18T11:53:13Z","role":"primary","sha256":"fb99135e22841bb564b275b5c0755ce1e5418faff2c806f25d4a11696214c87c","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/awlevin/typesafe-computer-use/HEAD/LICENSE"}],"id":"github:awlevin/typesafe-computer-use","identifiers":{},"kind":"agent","last_verified_at":"2026-10-18T11:53:03Z","licenses":{"code":{"basis":"repository LICENSE header; not a weights/data license","declared":"MIT","retrieved_at":"2026-10-18T11:53:13Z","url":"https://raw.githubusercontent.com/awlevin/typesafe-computer-use/HEAD/LICENSE"},"data":null,"document":null,"weights":null},"links":[{"rel":"primary","url":"https://github.com/awlevin/typesafe-computer-use"}],"name":"typesafe-computer-use","notes":"Also called jev. The main loop drives macOS through Vision OCR, the accessibility tree and synthetic input; the Windows adapter (UI Automation, SendInput, Windows OCR) is documented as experimental and untested on Windows. An opt-in browser backend reads the DOM over the Chrome DevTools Protocol, and the Linux sandbox runs only that backend. Linux desktop control is through the OSWorld JevAgent adapter inside OSWorld's Ubuntu VM. Every decision calls the hosted TypeSafe API, so a TypeSafe key is required; an Anthropic or OpenAI-compatible writer is optional. Per-step cost and latency comparisons and the OSWorld run logs are the author's and were not reproduced. The README marks the project beta. Code was read, not run.","published_at":null,"relations":[],"review_status":"curated","scope":"core","summary":"Computer-use loop that reads the screen with OCR and accessibility labels, has the hosted TypeSafe classifier choose each next action with a confidence, and calls a writer model only for free text.","topics":["efficiency","action-prediction","screen-understanding"],"updated_at":null,"url":"https://github.com/awlevin/typesafe-computer-use"}

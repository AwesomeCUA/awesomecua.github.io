ill-induction/377abe0623a37eaf7f03bdd26cb97bb5331acf47/asi/induce/induce_actions.py"},{"method":"editorial_primary_review","retrieved_at":"2026-10-18T16:20:00Z","role":"primary","sha256":"a68f4b730a140058782e75ff8eeb3001601d94f20ae3fd9d9e4ccb5a797374a7","supports":["summary","notes"],"url":"https://raw.githubusercontent.com/zorazrw/agent-skill-induction/377abe0623a37eaf7f03bdd26cb97bb5331acf47/asi/autoeval/evaluate_trajectory.py"},{"method":"editorial_primary_review","retrieved_at":"2026-10-18T16:20:01Z","role":"primary","sha256":"e7b0947791ad9e64aeef81111f89a3934b01afeae98dae307f422d418362211b","supports":["notes","details.license_components_note"],"url":"https://raw.githubusercontent.com/zorazrw/agent-skill-induction/377abe0623a37eaf7f03bdd26cb97bb5331acf47/browsergym/core/pyproject.toml"},{"method":"editorial_primary_review","retrieved_at":"2026-10-18T16:20:01Z","role":"primary","sha256":"da89f9867822be4b8adb1e601d9e9226c195016c6508015eb7593e68ead0c98a","supports":["licenses.code","notes"],"url":"https://raw.githubusercontent.com/zorazrw/agent-skill-induction/377abe0623a37eaf7f03bdd26cb97bb5331acf47/LICENSE"},{"method":"license_header","retrieved_at":"2026-10-19T07:15:16Z","role":"primary","sha256":"da89f9867822be4b8adb1e601d9e9226c195016c6508015eb7593e68ead0c98a","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/zorazrw/agent-skill-induction/HEAD/LICENSE"}],"id":"github:zorazrw/agent-skill-induction","identifiers":{},"kind":"framework","last_verified_at":"2026-10-19T07:15:07Z","licenses":{"code":{"basis":"repository LICENSE header","declared":"CC-BY-SA-4.0","retrieved_at":"2026-10-19T07:15:16Z","url":"https://raw.githubusercontent.com/zorazrw/agent-skill-induction/HEAD/LICENSE"},"data":null,"document":null,"weights":null},"links":[{"rel":"primary","url":"https://github.com/zorazrw/agent-skill-induction"}],"name":"Agent Skill Induction (ASI)","notes":"Research code by Zora Zhiruo Wang and coauthors. The agent (asi/agent.py) observes BrowserGym pages through the flattened accessibility tree by default, with HTML and screenshot inputs as options, and acts through BrowserGym's action set. run_online.py alternates solving WebArena tasks, judging the trajectory with the autoeval LLM evaluator, inducing website-specific skill functions (asi/induce/induce_actions.py) and testing them before they are added; the README also runs AWM and vanilla baselines from the same script. The repository vendors a copy of BrowserGym packages (browsergym/, Apache-2.0 per their pyproject files) and expects self-hosted WebArena sites. The root LICENSE is CC BY-SA 4.0. No code was run and no result was reproduced.","published_at":null,"relations":[{"evidence_url":"https://raw.githubusercontent.com/zorazrw/agent-skill-induction/HEAD/README.md","target_id":"github:servicenow/browsergym","type":"uses"},{"evidence_url":"https://raw.githubusercontent.com/zorazrw/agent-skill-induction/HEAD/README.md","target_id":"github:web-arena-x/webarena","type":"uses"},{"evidence_url":"https://raw.githubusercontent.com/zorazrw/agent-skill-induction/HEAD/README.md","target_id":"arxiv:2504.06821","type":"documented_by"}],"review_status":"curated","scope":"core","summary":"Official code for agent skill induction on WebArena: an LLM judge checks each trajectory, successful episodes become Python skill functions, and skills join the action space only after generated tests pass.","topics":["web-navigation","workflow","memory"],"updated_at":null,"url":"https://github.com/zorazrw/agent-skill-induction"}

87a95dc539e882bf172db4e3a","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/kortix-ai/agent-computer-use/d67eca2fadffa76c46d448e091b0ec4243e90b59/LICENSE"},{"method":"license_header","retrieved_at":"2026-10-20T08:36:56Z","role":"primary","sha256":"1e40d4e4a07efcc82df9df675c07c365b8a7a7b87a95dc539e882bf172db4e3a","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/kortix-ai/agent-computer-use/HEAD/LICENSE"},{"method":"github_repository_identity","retrieved_at":"2026-10-20T08:35:21Z","role":"primary","sha256":"f1cf004fcfb3d3e7d626574385e9eebd8a25b2eba62b31f2e953f1b030a30e7d","supports":["aliases"],"url":"https://api.github.com/repos/kortix-ai/agent-click"},{"method":"github_repository_identity","retrieved_at":"2026-10-20T08:35:24Z","role":"primary","sha256":"f1cf004fcfb3d3e7d626574385e9eebd8a25b2eba62b31f2e953f1b030a30e7d","supports":["aliases"],"url":"https://api.github.com/repos/kortix-ai/agent-computer-use"}],"id":"github:kortix-ai/agent-computer-use","identifiers":{},"kind":"tool","last_verified_at":"2026-10-20T08:36:34Z","licenses":{"code":{"basis":"repository LICENSE header","declared":"MIT","retrieved_at":"2026-10-20T08:36:56Z","url":"https://raw.githubusercontent.com/kortix-ai/agent-computer-use/HEAD/LICENSE"},"data":null,"document":null,"weights":null},"links":[{"rel":"primary","url":"https://github.com/kortix-ai/agent-computer-use"}],"name":"agent-computer-use","notes":"Published on npm as agent-cu (package.json 0.1.1 at the inspected commit) with precompiled binaries, and also installable as an agent skill (skills/agent-computer-use/SKILL.md). Commands snapshot an app's accessibility tree into @eN refs or query it with a selector DSL (role, name, id, parent-child chains), then click, type, press keys, scroll, drag, move or resize windows, wait for elements, take screenshots, and run JSON batches or YAML workflows; output is JSON by default. Backends: macOS uses AXUIElement with CGEvent input, Windows uses UI Automation, and Linux uses AT-SPI2 over D-Bus with xdotool for input. Electron apps can be driven over the Chrome DevTools Protocol, but automatic Electron detection and relaunch with a debug port is implemented only on macOS (cli/crates/agent-computer-use-cdp/src/detect.rs). The README marks every platform as preview and states that the project is no longer maintained, recommending Cua Driver instead. The repository was formerly named kortix-ai/agent-click (same GitHub repository ID). The tool contains no model or agent loop.","published_at":null,"relations":[],"review_status":"curated","scope":"core","summary":"Rust CLI (agent-cu) that lets agents snapshot desktop app accessibility trees into element refs or selectors and click, type, scroll or drag through AX on macOS, UI Automation on Windows and AT-SPI2 on Linux.","topics":["automation","tool-integration","screen-understanding","history"],"updated_at":null,"url":"https://github.com/kortix-ai/agent-computer-use"}

y"},{"method":"editorial_primary_review","retrieved_at":"2026-10-20T08:40:06Z","role":"primary","sha256":"a424dc623f967b6d40ee8c9369fd5c19a73345853ff84cac0bec69fd852dbddb","supports":["notes"],"url":"https://raw.githubusercontent.com/prakhar1114/ai_mime/0d5e9d3168cdde02d43448fa4a80521ebac3501d/src/ai_mime/record/capture.py"},{"method":"editorial_primary_review","retrieved_at":"2026-10-20T08:39:12Z","role":"primary","sha256":"e30cdf0b24abf56cf7465e115dae74f3438e183356e5b3ec82c3531ed068d4b5","supports":["notes"],"url":"https://raw.githubusercontent.com/prakhar1114/ai_mime/0d5e9d3168cdde02d43448fa4a80521ebac3501d/pyproject.toml"},{"method":"editorial_primary_review","retrieved_at":"2026-10-20T08:39:22Z","role":"primary","sha256":"9f31d9ff0d3bb24073544e54810ab69bc51f713d2e61334a0a1fa19978cda8da","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/prakhar1114/ai_mime/0d5e9d3168cdde02d43448fa4a80521ebac3501d/LICENSE"},{"method":"license_header","retrieved_at":"2026-10-20T08:41:20Z","role":"primary","sha256":"9f31d9ff0d3bb24073544e54810ab69bc51f713d2e61334a0a1fa19978cda8da","supports":["licenses.code"],"url":"https://raw.githubusercontent.com/prakhar1114/ai_mime/HEAD/LICENSE"}],"id":"github:prakhar1114/ai_mime","identifiers":{},"kind":"agent","last_verified_at":"2026-10-20T08:40:23Z","licenses":{"code":{"basis":"repository LICENSE header; not a weights/data license","declared":"MIT","retrieved_at":"2026-10-20T08:41:20Z","url":"https://raw.githubusercontent.com/prakhar1114/ai_mime/HEAD/LICENSE"},"data":null,"document":null,"weights":null},"links":[{"rel":"primary","url":"https://github.com/prakhar1114/ai_mime"}],"name":"AI Mime","notes":"Requires macOS 13 or newer, Python 3.12 and Accessibility, Screen Recording and Input Monitoring permissions; Windows is not supported yet. The recorder (pynput listeners and mss screenshots) writes a manifest of clicks, typing, hotkeys and scrolls with pre-action screenshots, plus optional extract and detail notes. Reflection turns the trace into a coordinate-free schema.json; an optimizer writes optimized_plan.json, preferring script steps, then browser_harness steps (Chrome CDP through a browser-harness git submodule), then ui_agent steps; a build agent packages a Claude Skill-compatible folder with run.sh, inputs and a fallback plan. The ui_agent drives the Mac in the foreground through cua-computer-server MCP tools, which AI Mime extends with combined screenshot-plus-accessibility-tree reads, and is told to target accessibility elements before screenshot coordinates. Agent runtimes are Anthropic (Claude Code) or OpenAI (Codex), selected during onboarding, with custom providers in user_config.yml. A prebuilt macOS DMG is linked from the README. Code was read, not run.","published_at":null,"relations":[],"review_status":"curated","scope":"core","summary":"macOS app that records a demonstrated task, has an agent compile it into a portable skill of scripts, browser CDP steps and computer-use fallbacks, and patches the skill when a rerun breaks.","topics":["recording","workflow","automation","robustness"],"updated_at":null,"url":"https://github.com/prakhar1114/ai_mime"}
